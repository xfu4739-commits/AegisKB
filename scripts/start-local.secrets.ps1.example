# 复制本文件为 start-local.secrets.ps1（已在 .gitignore），填入 Key 后保存。
# 然后照常运行：  .\scripts\start-local.ps1   或双击  scripts\start-local.cmd

# 必填：阿里云百炼 DashScope API Key
$env:ALI_BAI_LIAN_API_KEY = "sk-在这里粘贴百炼-DashScope-API-Key"

# 可选：不用就保持 ""
$env:TAVILY_API_KEY = ""
$env:ALIBABA_CLOUD_ACCESS_KEY_ID = ""
$env:ALIBABA_CLOUD_ACCESS_KEY_SECRET = ""
